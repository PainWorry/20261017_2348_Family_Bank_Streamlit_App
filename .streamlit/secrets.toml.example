# Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml for local development or paste into Streamlit Community Cloud Secrets

[auth]
cookie_name = "family_bank_session"

# Optional: Add or customize users and passwords (pre-hashed with Bcrypt or PBKDF2)
# Generate hashes using: python hash_tool.py
# [auth.users.dad]
# display_name = "Dad (Bank Admin)"
# role = "admin"
# password_hash = "$2b$12$..."

# [auth.users.member1]
# display_name = "Member 1"
# role = "member"
# password_hash = "$2b$12$..."

# ==============================================================
# Google Sheets Mirror Configuration (Streamlit Community Cloud)
# ==============================================================
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project.iam.gserviceaccount.com"
